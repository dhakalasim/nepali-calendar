# Copy to .env and fill in to enable real email reminders.
# With SMTP_HOST blank, reminders are printed to the backend console instead.

# --- Database (only needed when running the backend outside Docker) ---
# DATABASE_URL=postgresql+psycopg2://nepcal:nepcal@localhost:5432/nepcal

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Nepali Calendar <no-reply@example.com>

# Where reminder emails are sent (comma separated for multiple recipients)
NOTIFY_TO=

# Hour of day (Asia/Kathmandu, 0-23) to send the daily reminder digest
NOTIFY_HOUR=7

# Shown as the "open the calendar" link inside reminder emails
APP_BASE_URL=http://localhost:5173

# Example for Gmail (use an App Password, not your login password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# NOTIFY_TO=you@gmail.com
