# Copy to .env and fill in to enable real reminders.
# Provider blank  ->  that channel's reminders are printed to the backend console.
# WHERE reminders go (email addresses / phone numbers) is set in the app UI (gear
# icon), not here. NOTIFY_TO below is only a fallback if the UI field is empty.

# --- Database (only needed when running the backend outside Docker) ---
# DATABASE_URL=postgresql+psycopg2://nepcal:nepcal@localhost:5432/nepcal

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Nepali Calendar <no-reply@example.com>
NOTIFY_TO=

# Example for Gmail (use an App Password, not your login password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password

# --- Text messages / Twilio ---
# From the Twilio console: Account SID, Auth Token, and a Messaging-capable
# number (or a Messaging Service SID starting with "MG").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Scheduler ---
# Hour of day (Asia/Kathmandu, 0-23) to send the daily reminder digest
NOTIFY_HOUR=7

# Shown as the "open the calendar" link inside reminder emails
APP_BASE_URL=http://localhost:5273
