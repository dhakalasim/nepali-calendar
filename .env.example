# Copy to .env and fill in to enable real reminders:  cp .env.example .env
# Provider blank -> that channel's reminders are printed to the backend console.
# WHERE reminders go (emails / phone numbers) is set in the app UI (gear icon).
# Reload the backend after editing:  docker compose up -d backend
# (plain "restart" does NOT re-read this file)

# --- Database (only needed when running the backend outside Docker) ---
# DATABASE_URL=postgresql+psycopg2://nepcal:nepcal@localhost:5432/nepcal

# ===== EMAIL / SMTP =========================================================
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nepali Calendar <no-reply@example.com>
NOTIFY_TO=

# ===== SMS =================================================================
# "auto" uses whichever provider below has credentials.
SMS_PROVIDER=auto

# AakashSMS - Nepal gateway, simplest signup (https://aakashsms.com)
AAKASH_SMS_TOKEN=

# Sparrow SMS - Nepal gateway (https://sparrowsms.com)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Twilio - international (Nepal needs Messaging Geographic Permissions on)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ===== Scheduler ===========================================================
# Hour of day (Asia/Kathmandu, 0-23) for the daily reminder digest
NOTIFY_HOUR=7
APP_BASE_URL=http://localhost:5273
